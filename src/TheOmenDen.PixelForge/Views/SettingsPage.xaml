<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TheOmenDen.PixelForge.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollView Padding="24">
        <StackPanel MaxWidth="1000" Spacing="24">

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />

            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Appearance" />

                <Border
                    Padding="16"
                    Background="{ThemeResource ToolPanelBackgroundBrush}"
                    BorderBrush="{ThemeResource ToolPanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource OverlayCornerRadius}">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="App theme" />
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Applies immediately and is remembered between sessions." />

                        <RadioButtons
                            x:Name="ThemeSelector"
                            AutomationProperties.AutomationId="ThemeSelector"
                            AutomationProperties.Name="App theme"
                            SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}">
                            <x:String>Use system setting</x:String>
                            <x:String>Light</x:String>
                            <x:String>Dark</x:String>
                        </RadioButtons>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollView>
</Page>
