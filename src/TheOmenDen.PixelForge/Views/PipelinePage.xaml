<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TheOmenDen.PixelForge.Views.PipelinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:CommunityToolkit.WinUI.Behaviors"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:TheOmenDen.PixelForge.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:vm="using:TheOmenDen.PixelForge.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Batch export" />
            <!--
                One line, deliberately. This row is Auto and the picker below it is the `*` row, so
                a subtitle that wraps to two lines takes ~20 DIPs straight off the ScrollViewer —
                which is enough for the ItemsRepeater to realize one slot fewer, and the tenth
                expander then has no automation id for ui-tests.ps1 to find. Longer copy goes in
                the caption beside the preview, whose row is pinned by the 144-DIP still.
            -->
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Tick the parts you want, then export one sheet per combination." />
        </StackPanel>

        <InfoBar
            Grid.Row="1"
            AutomationProperties.AutomationId="PacksMissingInfoBar"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.PacksMissing, Mode=OneWay}"
            Message="Your three art pack folders are not set yet. Add them in Settings before you export."
            Severity="Warning">
            <InfoBar.ActionButton>
                <Button
                    AutomationProperties.AutomationId="BtnGoToPackSettings"
                    Click="OnGoToSettings"
                    Content="Open Settings" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!--  Output and mode  -->
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox
                AutomationProperties.AutomationId="OutputFolderText"
                AutomationProperties.Name="Output folder"
                Header="Output folder"
                IsReadOnly="True"
                PlaceholderText="Choose a folder"
                Text="{x:Bind ViewModel.OutputFolder, Mode=OneWay}"
                ToolTipService.ToolTip="Where the sheets and their list files get written. Use Browse to set it. Files with the same name are overwritten." />

            <Button
                Grid.Column="1"
                Margin="0,28,0,0"
                AutomationProperties.AutomationId="BtnBrowseOutput"
                AutomationProperties.Name="Browse for output folder"
                Command="{x:Bind ViewModel.BrowseOutputCommand}"
                Content="Browse"
                ToolTipService.ToolTip="Pick the folder to save into. An empty folder is the safest choice." />

            <!--
                UpdateSourceTrigger is load-bearing on both boxes, exactly as it is on the slot
                filters: the default commits on LostFocus, so UI automation set-value would write
                the text and the view model would never see it.
            -->
            <StackPanel
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="0,16,0,0"
                Orientation="Horizontal"
                Spacing="12">
                <TextBox
                    Width="220"
                    AutomationProperties.AutomationId="HeroPrefixText"
                    AutomationProperties.Name="Hero prefix"
                    Header="Hero prefix"
                    PlaceholderText="villager"
                    Text="{x:Bind ViewModel.HeroPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ToolTipService.ToolTip="What new character folders are named after, such as villager. Each one gets a number: villager_01, villager_02. A body you have exported before keeps the number it already has, whatever you type here." />

                <TextBox
                    Width="220"
                    AutomationProperties.AutomationId="ClassNameText"
                    AutomationProperties.Name="Class name"
                    Header="Class name (optional)"
                    PlaceholderText="ranger"
                    Text="{x:Bind ViewModel.ClassName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ToolTipService.ToolTip="Names the set of equipment you have ticked, such as ranger. Leave it empty to export the character and the equipment as separate layers without naming a set." />
            </StackPanel>

            <StackPanel
                Grid.Row="2"
                Grid.ColumnSpan="2"
                Margin="0,16,0,0"
                Spacing="4">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Mode" />

                <!--
                    Segmented, not RadioButtons: three short mutually-exclusive toggles is the
                    control's stated use (2-5 items, no overflow), and it reads as a mode switch
                    rather than a settings choice.
                -->
                <!--
                    SelectedIndex is driven from code-behind, not a TwoWay x:Bind. Segmented
                    applies its initial index from OnApplyTemplate — after this page's bindings
                    are live — so a TwoWay binding races the user: switch mode quickly enough
                    after the page appears and the control's deferred initialisation writes its
                    own index back over the choice. That silently exports Layered.
                -->
                <controls:Segmented
                    x:Name="ExportModeSegmented"
                    AutomationProperties.AutomationId="ExportModeSegmented"
                    AutomationProperties.Name="Export mode"
                    SelectionChanged="OnExportModeChanged"
                    SelectionMode="Single">
                    <controls:SegmentedItem
                        Content="Curated"
                        Icon="{ui:FontIcon Glyph=&#xE81E;}"
                        ToolTipService.ToolTip="The trimmed, game-ready sheet. Pick this if you are not sure." />
                    <controls:SegmentedItem
                        Content="Full"
                        Icon="{ui:FontIcon Glyph=&#xE7C4;}"
                        ToolTipService.ToolTip="The untrimmed sheet with every frame and every direction the source art has." />
                    <controls:SegmentedItem
                        Content="Both"
                        Icon="{ui:FontIcon Glyph=&#xE8C6;}"
                        ToolTipService.ToolTip="Writes both kinds of sheet, which doubles the file count." />
                </controls:Segmented>
                <TextBlock
                    AutomationProperties.AutomationId="ExportModeDescription"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.ModeDescription, Mode=OneWay}"
                    TextWrapping="Wrap" />

                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="File type" />

                <!--
                    Driven from code-behind for the same reason the mode Segmented above is:
                    Segmented applies its initial index from OnApplyTemplate, after this page's
                    bindings are live, so a TwoWay x:Bind races the user and silently writes its
                    own index back over an early choice.
                -->
                <controls:Segmented
                    x:Name="ExportFormatSegmented"
                    AutomationProperties.AutomationId="ExportFormatSegmented"
                    AutomationProperties.Name="File type"
                    SelectionChanged="OnExportFormatChanged"
                    SelectionMode="Single">
                    <!--
                        These carry explicit AutomationIds where the mode Segmented above relies on
                        generated ones. Its third segment is also called "Both", and the ids the
                        tree generates come from the content — so a generated id here would be
                        ambiguous with it, and the automation helper takes the first match. The
                        Names disambiguate the same collision for a screen reader, which would
                        otherwise hear "Both" twice on one page with nothing to tell them apart.
                    -->
                    <controls:SegmentedItem
                        AutomationProperties.AutomationId="ExportFormatWebp"
                        AutomationProperties.Name="WebP only"
                        Content="WebP"
                        Icon="{ui:FontIcon Glyph=&#xE8B9;}"
                        ToolTipService.ToolTip="Smaller files, read by Corvus Connection. Unity and MonoGame cannot open these." />
                    <controls:SegmentedItem
                        AutomationProperties.AutomationId="ExportFormatPng"
                        AutomationProperties.Name="PNG only"
                        Content="PNG"
                        Icon="{ui:FontIcon Glyph=&#xEB9F;}"
                        ToolTipService.ToolTip="The only kind Unity and MonoGame can import. Pick this for a game engine." />
                    <controls:SegmentedItem
                        AutomationProperties.AutomationId="ExportFormatBoth"
                        AutomationProperties.Name="Both file types"
                        Content="Both"
                        Icon="{ui:FontIcon Glyph=&#xE8C6;}"
                        ToolTipService.ToolTip="Writes both kinds of file, which doubles the file count again." />
                </controls:Segmented>
                <TextBlock
                    AutomationProperties.AutomationId="ExportFormatDescription"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.FormatDescription, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!--  Selection — one expander per slot the catalogue can fill, plus the tone axis.  -->
        <Grid
            Grid.Row="3"
            ColumnSpacing="16"
            RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                The still the current selection composes to. Source and size are both set from
                CompositePreview: the view model deals in recipes, never in image types.
                Stretch="None" because PalettePreview already upscales nearest-neighbour, and
                WinUI's Image has no interpolation-mode switch — letting it scale would blur the
                pixel art it exists to show.
            -->
            <!--
                A Grid, not a horizontal StackPanel: the still is a fixed 432x144 (CompositePreview
                sets it from PreviewScale), and at the default 1360-DIP window this column is only
                ~716 wide. A StackPanel measures its children at infinite width, so the caption
                would silently clip at the column edge instead of wrapping. A * column wraps at
                whatever is left over, at any window size.
            -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image
                    x:Name="CompositePreviewImage"
                    HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="CompositePreviewImage"
                    AutomationProperties.Name="Composite preview"
                    Stretch="None"
                    ToolTipService.ToolTip="One example of your picks stacked together. It is a sample, not every file the run will write." />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="SelectionHint"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Open a section below and tick the files you want. Every ticked file is combined with every ticked file in the other sections, so the file count climbs fast. A section left empty is skipped, except for bottom, top, and head, which a character always needs."
                    TextWrapping="Wrap" />
            </Grid>

            <!--
                ItemsRepeater is a layout primitive: it has no scrolling of its own, so without
                this ScrollViewer ten expanded slots clip silently rather than scroll. It is used
                over ten hand-written expanders because the blocks differ only by which group they
                bind to, and a repeated block is a block that drifts.
            -->
            <ScrollViewer
                Grid.Row="1"
                Padding="0,0,16,0"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ItemsRepeater ElementPrepared="OnSlotElementPrepared" ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:SlotGroupViewModel">
                            <!--
                                No AutomationId here on purpose. SettingsExpander's own peer is a
                                Group with no pattern; the element that expands is the header
                                ToggleButton inside its template, so OnSlotElementPrepared stamps
                                ExpanderAutomationId onto that instead. Setting it in both places
                                would make the id match two elements and stop resolving at all.
                            -->
                            <controls:SettingsExpander
                                Description="{x:Bind Description, Mode=OneWay}"
                                Header="{x:Bind Header}"
                                ItemsSource="{x:Bind Items}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <!--
                                        A TextBox rather than an AutoSuggestBox: AutoSuggestBox's
                                        peer is a Group wrapping an unnamed Edit, so the id lands
                                        on something with no ValuePattern and UIA set-value cannot
                                        reach the filter at all. There are no suggestions to show
                                        either — the list below is the result.
                                        UpdateSourceTrigger is load-bearing: the default commits on
                                        LostFocus, so set-value writes the text and nothing filters.
                                    -->
                                    <TextBox
                                        Width="180"
                                        AutomationProperties.AutomationId="{x:Bind local:PipelinePage.SlotAutomationId('SlotFilter', Slot)}"
                                        AutomationProperties.Name="{x:Bind local:PipelinePage.SlotLabel('Filter', Header)}"
                                        PlaceholderText="Filter"
                                        Text="{x:Bind Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTipService.ToolTip="Type part of a name to shorten this list, such as hair1. Clear the box to see everything again. Filtering hides rows but does not untick them." />
                                    <ToggleSwitch
                                        AutomationProperties.AutomationId="{x:Bind local:PipelinePage.SlotAutomationId('SlotVariants', Slot)}"
                                        AutomationProperties.Name="{x:Bind local:PipelinePage.SlotLabel('Include colour variants for', Header)}"
                                        IsOn="{x:Bind IncludeVariants, Mode=TwoWay}"
                                        OffContent="Base only"
                                        OnContent="All colours"
                                        ToolTipService.ToolTip="Base only uses just the file you ticked. All colours also brings in every ready-made recolor of it, which can turn one tick into several files." />
                                </StackPanel>
                                <controls:SettingsExpander.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PartialSelectionItem">
                                        <controls:SettingsCard Description="{x:Bind Status, Mode=OneWay}" Header="{x:Bind Name}">
                                            <CheckBox
                                                AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                                AutomationProperties.Name="{x:Bind Name}"
                                                IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                        </controls:SettingsCard>
                                    </DataTemplate>
                                </controls:SettingsExpander.ItemTemplate>
                            </controls:SettingsExpander>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <ScrollViewer
                Grid.RowSpan="2"
                Grid.Column="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Skin tones" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Tick more than one tone and you get a separate sheet per tone. This only affects parts that show skin, so hair and clothes keep the colors they were drawn in."
                        TextWrapping="Wrap" />
                    <!--
                        UniformGrid is a panel, not an items control, so it arrives as the
                        ItemsPanel. Equal cells are the point: the swatches line up in a column
                        regardless of how long a ramp's name is.
                    -->
                    <ItemsControl
                        AutomationProperties.AutomationId="ToneList"
                        AutomationProperties.Name="Skin tones"
                        ItemsSource="{x:Bind ViewModel.Tones, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:UniformGrid Columns="1" RowSpacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ToneSelectionItem">
                                <CheckBox
                                    MinWidth="0"
                                    AutomationProperties.AutomationId="{x:Bind local:PipelinePage.ToneAutomationId(Name)}"
                                    AutomationProperties.Name="{x:Bind Name}"
                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        ToolTipService.ToolTip="{x:Bind Name}">
                                        <!--
                                            The fill is the ramp's own colour — data, not theming.
                                            The outline is theming, and it is what keeps a swatch
                                            that lands near the page background visible in both.
                                        -->
                                        <Border
                                            Width="16"
                                            Height="16"
                                            Background="{x:Bind local:PipelinePage.ToneBrush(Ramp)}"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{ThemeResource ControlCornerRadius}" />
                                        <TextBlock
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!--  Run  -->
        <Grid Grid.Row="4" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ProgressBar
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="ExportProgress"
                AutomationProperties.Name="Export progress"
                Maximum="100"
                Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" />

            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="ExportProgressText"
                Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" />

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="8">
                <!--  What the current selection and mode would actually produce, before running it.  -->
                <TextBlock
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="PlannedBreakdownText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind local:PipelinePage.PlannedBreakdown(ViewModel.PlannedCounts), Mode=OneWay}"
                    ToolTipService.ToolTip="How many files your current ticks and mode would write. Export stays off while this reads 0 files." />
                <Button
                    AutomationProperties.AutomationId="BtnLoadRoostSelection"
                    AutomationProperties.Name="Load the spec-079 selection"
                    Command="{x:Bind ViewModel.LoadRoostSelectionCommand}"
                    Content="Roost set (079)"
                    ToolTipService.ToolTip="Ticks the exact art the Roost avatar set is built from, and turns on every skin tone. Use it as a starting point you can change." />
                <!--
                    Bakes the named deliverable rather than the picker's cross product, so it
                    ignores both the selection and the mode toggle. Its own button because the
                    two produce different files under different names — see ExportRoostSetCommand.
                -->
                <Button
                    AutomationProperties.AutomationId="BtnExportRoostSet"
                    AutomationProperties.Name="Export the spec-079 deliverable"
                    Command="{x:Bind ViewModel.ExportRoostSetCommand}"
                    Content="Export 079 set"
                    ToolTipService.ToolTip="Writes the 16 finished Roost sheets, 7 bodies and 9 hairstyles, under the names the game looks for. It ignores your ticks and the mode above on purpose." />
                <Button
                    AutomationProperties.AutomationId="BtnExport"
                    Command="{x:Bind ViewModel.ExportCommand}"
                    Content="Export"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Writes one sheet for every combination your ticks add up to. Check the file count on the left first." />
                <Button
                    AutomationProperties.AutomationId="BtnCancelExport"
                    Command="{x:Bind ViewModel.ExportCancelCommand}"
                    Content="Cancel"
                    IsEnabled="{x:Bind ViewModel.IsExporting, Mode=OneWay}"
                    ToolTipService.ToolTip="Stops the run. Sheets already written stay where they are, and the list files are still saved for them." />
            </StackPanel>

            <!--
                Queued rather than a single caption line: a 79-sheet run can produce a summary
                and a manifest failure, and the behavior stacks and times out each one.
            -->
            <InfoBar
                Grid.Row="1"
                Grid.ColumnSpan="3"
                Margin="0,8,0,0"
                AutomationProperties.AutomationId="ExportStatusBar">
                <interactivity:Interaction.Behaviors>
                    <behaviors:StackedNotificationsBehavior x:Name="StatusNotifications" />
                </interactivity:Interaction.Behaviors>
            </InfoBar>
        </Grid>
    </Grid>
</Page>
