<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TheOmenDen.PixelForge.Views.CanvasPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        x:Name="RootGrid"
        ColumnSpacing="0"
        SizeChanged="OnRootSizeChanged">

        <!--
            Shell responsiveness is NavigationView's job (PaneDisplayMode="Auto"). These states
            handle what it cannot: below 900 effective DIPs the tool panel drops from a
            labelled 280px column to a 56px icon strip, so the canvas keeps usable width.

            No AdaptiveTrigger here on purpose — MinWindowWidth compares against raw window
            pixels, so on a 150% display a 900 threshold does not fire until 600 DIPs. The
            code-behind divides by XamlRoot.RasterizationScale and calls GoToState, which is
            correct at every DPI. Verified on a 144-DPI monitor.
        -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ToolPanelStates">
                <VisualState x:Name="ToolPanelWide" />
                <VisualState x:Name="ToolPanelCompact">
                    <VisualState.Setters>
                        <Setter Target="ToolPanelColumn.Width" Value="56" />
                        <Setter Target="ToolLabels.Visibility" Value="Collapsed" />
                        <Setter Target="ToolPanel.Padding" Value="8" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ToolPanelColumn" Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Tools  -->
        <Border
            x:Name="ToolPanel"
            Padding="16"
            Background="{ThemeResource ToolPanelBackgroundBrush}"
            BorderBrush="{ThemeResource ToolPanelBorderBrush}"
            BorderThickness="0,0,1,0">
            <StackPanel Spacing="8">
                <TextBlock
                    x:Name="ToolLabels"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Tools" />

                <Button
                    AutomationProperties.AutomationId="BtnToolPencil"
                    AutomationProperties.Name="Pencil tool"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    ToolTipService.ToolTip="Pencil. Paints one pixel at a time in the color you picked.">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="16" Glyph="&#xE70F;" />
                        <TextBlock Text="Pencil" Visibility="{x:Bind ToolLabels.Visibility, Mode=OneWay}" />
                    </StackPanel>
                </Button>

                <Button
                    AutomationProperties.AutomationId="BtnToolFill"
                    AutomationProperties.Name="Fill tool"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    ToolTipService.ToolTip="Fill. Floods the area you click with the color you picked.">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="16" Glyph="&#xE7B3;" />
                        <TextBlock Text="Fill" Visibility="{x:Bind ToolLabels.Visibility, Mode=OneWay}" />
                    </StackPanel>
                </Button>

                <Button
                    AutomationProperties.AutomationId="BtnToolEraser"
                    AutomationProperties.Name="Eraser tool"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    ToolTipService.ToolTip="Eraser. Clears pixels back to see-through.">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="16" Glyph="&#xE75C;" />
                        <TextBlock Text="Eraser" Visibility="{x:Bind ToolLabels.Visibility, Mode=OneWay}" />
                    </StackPanel>
                </Button>

            </StackPanel>
        </Border>

        <!--  Canvas surface  -->
        <Grid Grid.Column="1" Background="{ThemeResource CanvasBackdropBrush}">
            <Border
                Width="320"
                Height="320"
                Padding="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource CanvasCheckerLightBrush}"
                BorderBrush="{ThemeResource ToolPanelBorderBrush}"
                BorderThickness="1">
                <!--
                    The tools are shape only: nothing is wired to any of them yet, and saying so is
                    cheaper than a new user clicking each one to find out.

                    On the surface rather than in the tool panel, which was the first attempt: the
                    panel collapses to a 56px icon strip below 900 effective DIPs, and on a 150%
                    display the default 1360-DIP window is already past that threshold — so a
                    notice hidden with the labels is hidden in the state most people open the app in.
                -->
                <StackPanel VerticalAlignment="Center" Spacing="8">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Sprite surface" />
                    <TextBlock
                        AutomationProperties.AutomationId="CanvasNotice"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Drawing is not switched on yet. For now, use Assets to look at the art, Palette to build skin colors, and Pipeline to bake sheets."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
