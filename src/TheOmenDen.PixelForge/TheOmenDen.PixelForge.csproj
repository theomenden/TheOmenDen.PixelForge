<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>TheOmenDen.PixelForge</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <!-- Used directly by app-layer services: Optional<T> and FullPath appear in
         SourcePackService's public surface. Declared explicitly rather than relied on
         transitively through the Core ProjectReference. -->
    <PackageReference Include="DotNext" />
    <PackageReference Include="Meziantou.Framework.FullPath" />
  </ItemGroup>

  <ItemGroup>
    <!-- ZLinq replaces System.Linq (see GlobalUsings.cs for the drop-in attribute). -->
    <PackageReference Include="ZLinq" />
    <PackageReference Include="ZLinq.DropInGenerator" PrivateAssets="all" />
    <PackageReference Include="Riok.Mapperly" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinUI toolkit + GPU-accelerated canvas -->
    <PackageReference Include="CommunityToolkit.WinUI.Animations" />
    <PackageReference Include="CommunityToolkit.WinUI.Behaviors" />
    <PackageReference Include="CommunityToolkit.WinUI.Collections" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.ColorPicker" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" />
    <PackageReference Include="CommunityToolkit.WinUI.Converters" />
    <PackageReference Include="CommunityToolkit.WinUI.Extensions" />
    <PackageReference Include="CommunityToolkit.WinUI.Helpers" />
    <PackageReference Include="CommunityToolkit.WinUI.Triggers" />
    <PackageReference Include="Microsoft.Graphics.Win2D" />
    <PackageReference Include="SkiaSharp.Views.WinUI" />
    <PackageReference Include="ColorCode.Core" />
  </ItemGroup>

  <ItemGroup>
    <!-- Host + logging. Serilog is composed here only; the rest of the app logs
         through ILogger<T> so nothing else takes a Serilog dependency. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Expressions" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Async" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.Debug" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.EventLog" />
    <PackageReference Include="Serilog.Enrichers.Process" />
    <PackageReference Include="Serilog.Enrichers.Memory" />
    <PackageReference Include="SerilogAnalyzer" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Serilog.Settings.Configuration resolves the sinks and enrichers named in appsettings.json's
    "Using" list by assembly name, then finds their extension methods by reflection. Nothing in
    the code calls WriteTo.Console or Enrich.WithProcessId, so without these roots the trimmer
    drops the assemblies entirely and LoadConfigurationAssemblies throws at host build — which
    under AOT is a hard crash before the window ever appears. This list must stay in step with
    the "Using" array; Serilog itself is rooted for MinimumLevel/Destructure/Enrich, which the
    reader also reaches reflectively.
  -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Serilog" />
    <TrimmerRootAssembly Include="Serilog.Sinks.Console" />
    <TrimmerRootAssembly Include="Serilog.Sinks.Debug" />
    <TrimmerRootAssembly Include="Serilog.Enrichers.Process" />
    <TrimmerRootAssembly Include="Serilog.Enrichers.Memory" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TheOmenDen.PixelForge.Core\TheOmenDen.PixelForge.Core.csproj" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <!--
      Native AOT, verified end to end: ILC compiles the whole app - WinUI/XAML, CsWinRT, Win2D,
      SkiaSharp, Core - into a single native exe, and the UI suite scores the same as it does
      against the JIT build.

      This replaced PublishTrimmed + PublishReadyToRun, which could not publish at all: ILLink
      reported trim warnings inside Microsoft.Windows.SDK.NET and WinRT.Runtime, which ILC's
      CsWinRT-aware path does not produce. AOT is the cleaner of the two here, not the more
      aggressive one. PublishReadyToRun is mutually exclusive with PublishAot.

      PublishTrimmed is deliberately not set *here*. The SDK still derives it from PublishAot, so
      it evaluates to true either way - but setting it directly also opted the project into
      ILLink's size-optimization path, which failed `dotnet build -c Release` with NETSDK1102
      because a build is not a self-contained publish. Under PublishAot that path is ILC's
      instead, and Release builds clean. Setting it back would re-break the Release build.

      The native link step shells out to vswhere, so publish needs
      "C:\Program Files (x86)\Microsoft Visual Studio\Installer" on PATH - a Developer prompt has
      it, a bare shell does not, and the failure surfaces as a garbled link.exe command line.
    -->
    <PublishAot Condition="'$(Configuration)' != 'Debug'">true</PublishAot>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Three referenced assemblies analyse dirty, and TreatWarningsAsErrors would otherwise fail
      the publish on code we do not own. Suppressed by code rather than by turning the switch off,
      so our own trim/AOT violations stay build errors - IL2104 and IL3053 are only ever the
      per-assembly aggregates for a *reference*; our own would surface as IL2026/IL3050 directly.

        Serilog.Settings.Configuration  resolves sinks and enrichers by reflection. Exercised, and
                                        it works - see the TrimmerRootAssembly list above, which is
                                        what makes it work. IL3000/IL3002 are its single-file
                                        assembly-discovery fallbacks, which the "Using" section in
                                        appsettings.json means we never reach.
        Serilog.Expressions             the Conditional() filter expression for the fatal sink.
        SkiaSharp.Views.WinUI.Native.Projection  trim-only (IL2104); ILC reports no AOT warning.
    -->
    <NoWarn>$(NoWarn);IL2104;IL3053;IL3000;IL3002</NoWarn>
  </PropertyGroup>
</Project>