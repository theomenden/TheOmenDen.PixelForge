<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- xUnit v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="ZLinq" />
    <PackageReference Include="ZLinq.DropInGenerator" PrivateAssets="all" />
    <!-- Self-cleaning scratch dirs for pipeline tests. -->
    <PackageReference Include="Meziantou.Framework.TemporaryDirectory" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TheOmenDen.PixelForge.Core\TheOmenDen.PixelForge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
